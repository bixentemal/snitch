# Copy this file to .env and fill in your camera credentials.
# .env is gitignored so your password stays local.

CAM_HOST=192.168.1.100
CAM_USER=admin
CAM_PASS=your_password_here

# RTSP port (Hikvision default is 554)
CAM_RTSP_PORT=554

# Which stream to pull:
#   1 = main stream  (101) full resolution, heavier
#   2 = sub stream   (102) lower resolution, smoother for realtime YOLO
CAM_STREAM=2
